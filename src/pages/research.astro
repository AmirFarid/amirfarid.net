---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import SectionHeader from '../components/SectionHeader.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentResearchProjects = projects.filter((project) => project.data.category === 'research');
const publications = (await getCollection('publications')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const researchInterests = [
  'Secure decentralized storage and authenticated writes',
  'Trusted execution and sensitive computation',
  'Verifiable decentralized and multi-agent AI systems',
  'Distributed inference and persistent agent memory',
  'Reliable provenance for models, data, and agent actions',
  'Adversarially resilient decentralized intelligence',
];

const publicationGroups = [
  {
    title: 'Journal Articles',
    items: publications.filter((publication) => publication.data.status === 'Published'),
  },
  {
    title: 'Preprints',
    items: publications.filter((publication) => publication.data.status === 'Preprint'),
  },
].filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Research"
  description="Research and publications by Amir M. Moghadamfarid on secure decentralized systems and trustworthy decentralized AI."
>
  <div class="page container stack">
    <SectionHeader
      eyebrow="Research"
      title="Secure and Verifiable Distributed Intelligence"
      summary="A research agenda connecting storage integrity, trusted execution, and distributed-systems resilience with emerging AI infrastructure."
    />

    <section class="prose">
      <p>
        My research is grounded in systems security, with a current focus on secure decentralized storage, authenticated
        writes, distributed repair, and trusted hardware. I am interested in how distributed infrastructure can preserve
        integrity, availability, recoverability, and verifiability when storage nodes, service providers, or other
        participants cannot be fully trusted.
      </p>
      <p>
        Building on this foundation, I want to investigate trustworthy decentralized and multi-agent AI systems. In
        particular, I am interested in protecting distributed inference and persistent agent memory, establishing
        reliable provenance for models, data, and agent actions, and using trusted execution to protect sensitive
        computations. I also want to study how decentralized AI systems can remain operational and verifiable when agents
        behave maliciously, infrastructure fails, or participants hold inconsistent state.
      </p>
      <p>
        My long-term goal is to connect storage integrity, trusted execution, and distributed-systems resilience with
        emerging AI infrastructure. This trajectory moves from authenticated and recoverable decentralized storage toward
        secure agent memory, verifiable inference, and adversarially resilient decentralized intelligence.
      </p>
    </section>

    <section class="stack">
      <h2>Research Interests</h2>
      <div class="grid grid-3">
        {
          researchInterests.map((interest) => (
            <article class="card stack" style="gap: 8px;">
              <h3>{interest}</h3>
            </article>
          ))
        }
      </div>
    </section>

    <section class="stack">
      <h2>Current Research</h2>
      <p class="muted">
        These projects develop integrity, availability, recoverability, and verifiability mechanisms for infrastructure
        that cannot assume fully trusted storage nodes, service providers, or participants.
      </p>
      <div class="grid grid-2">
        {
          currentResearchProjects.map((project) => (
            <article class="card stack" style="gap: 8px;">
              <h3>{project.data.title}</h3>
              <p class="muted">{project.data.summary}</p>
              <p><strong>{project.data.status}</strong></p>
              {project.data.links.length > 0 && (
                <div class="button-row">
                  {project.data.links.map((link) => (
                    <a class="button secondary" href={link.url}>
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="stack">
      <h2>Trajectory</h2>
      <div class="trajectory" aria-label="Research trajectory">
        <span>Authenticated and recoverable decentralized storage</span>
        <span aria-hidden="true">-&gt;</span>
        <span>secure agent memory and verifiable inference</span>
        <span aria-hidden="true">-&gt;</span>
        <span>adversarially resilient decentralized intelligence</span>
      </div>
    </section>

    <section id="publications" class="stack">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Publications</p>
          <h2>Publications</h2>
        </div>
        <a
          class="button secondary"
          href="https://scholar.google.com/citations?user=YsxSn4EAAAAJ&hl=en"
          target="_blank"
          rel="me noopener noreferrer"
        >
          Google Scholar
        </a>
      </div>
      {
        publicationGroups.map((group) => (
          <section class="stack" style="gap: 14px;">
            <h3>{group.title}</h3>
            <div class="stack" style="gap: 14px;">
              {group.items.map((publication) => (
                <PublicationItem {...publication.data} />
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>
